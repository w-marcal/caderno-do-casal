rules_version = '2';

// Regras do projeto "caderno-do-casal" / app "Conta a Dois".
//
// Onde colar: console.firebase.google.com > Firestore Database > aba "Regras"
// > substituir tudo > Publicar.
//
// PUBLIQUE ESTAS REGRAS ANTES de abrir a versao nova do app. Elas continuam
// aceitando os caminhos antigos (bloco LEGADO, no fim), entao o app atual
// segue funcionando enquanto voce publica.
//
// Modelo: cada casal tem uma "conta" com seus proprios lancamentos, plano,
// milhas e investimentos. Ninguem enxerga a conta de ninguem. Para entrar
// numa conta existente e preciso ter sido convidado pelo e-mail.

service cloud.firestore {
  match /databases/{database}/documents {

    function logado(){
      return request.auth != null && request.auth.token.email != null;
    }
    function meuEmail(){
      return request.auth.token.email.lower();
    }
    function dadosDaConta(contaId){
      return get(/databases/$(database)/documents/contas/$(contaId)).data;
    }
    function membro(contaId){
      return logado()
        && exists(/databases/$(database)/documents/contas/$(contaId))
        && request.auth.uid in dadosDaConta(contaId).membros;
    }
    // convite existe, e para o meu e-mail, e aponta para esta conta
    function convidadoPara(contaId){
      return logado()
        && exists(/databases/$(database)/documents/convites/$(meuEmail()))
        && get(/databases/$(database)/documents/convites/$(meuEmail())).data.contaId == contaId;
    }

    // Cada pessoa le e escreve so o proprio registro (guarda em qual conta esta).
    match /usuarios/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // Convite fica guardado pelo e-mail de quem foi convidado.
    match /convites/{email} {
      // o convidado le e apaga o proprio convite ao entrar
      allow read, delete: if logado() && meuEmail() == email;
      // quem ja e da conta convida e cancela convites dela
      allow create: if logado() && membro(request.resource.data.contaId);
      allow delete: if logado() && membro(resource.data.contaId);
    }

    match /contas/{contaId} {
      // ao criar, a pessoa precisa entrar como unico membro
      allow create: if logado()
        && request.resource.data.membros == [request.auth.uid];

      allow read: if membro(contaId) || convidadoPara(contaId);

      // membro edita a conta; convidado so pode se acrescentar
      allow update: if membro(contaId)
        || (convidadoPara(contaId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros','pessoas'])
            && request.resource.data.membros.hasAll(resource.data.membros)
            && request.resource.data.membros.size() == resource.data.membros.size() + 1
            && request.auth.uid in request.resource.data.membros);

      allow delete: if false;
    }

    // Lancamentos, plano, milhas e investimentos vivem dentro da conta.
    match /contas/{contaId}/{documento=**} {
      allow read, write: if membro(contaId);
    }

    // ---------------------------------------------------------------
    // LEGADO: os dados que existiam antes das contas separadas.
    // Serve so para o app migrar para dentro da conta de voces.
    // TROQUE pelos dois e-mails reais (os mesmos que ja estavam aqui).
    // Depois que a migracao rodar, este bloco pode ser apagado.
    // ---------------------------------------------------------------
    function original(){
      return logado() && meuEmail() in [
        'troque-pelo-email-do-felipe@exemplo.com',
        'troque-pelo-email-da-layla@exemplo.com'
      ];
    }
    match /caderno/{doc}      { allow read, write: if original(); }
    match /lancamentos/{doc}  { allow read, write: if original(); }
  }
}
