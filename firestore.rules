rules_version = '2';

// Regras do projeto "caderno-do-casal".
//
// Onde colar: console.firebase.google.com > Firestore Database > aba "Regras"
// > substituir tudo por este conteudo > Publicar.
//
// ANTES DE PUBLICAR, troque os dois e-mails abaixo pelos e-mails reais das
// contas criadas em Authentication > Users. Faca essa troca DIRETO NO CONSOLE
// e deixe este arquivo com os exemplos: o repositorio e publico, e e-mail
// commitado aqui fica indexado e permanente no historico do git.
//
// Antes disso, no console:
//   1. Authentication > Sign-in method > ativar "E-mail/senha"
//   2. Authentication > Sign-in method > DESATIVAR "Anonimo"
//   3. Authentication > Users > criar as duas contas (Felipe e Layla)
//   4. Authentication > Settings > User actions > desmarcar
//      "Enable create (sign-up)", para ninguem se cadastrar sozinho
//
// O passo 4 importa: a chave do Firebase e publica por natureza (esta dentro
// do index.html, que qualquer um baixa). Sem ele, alguem poderia criar uma
// conta no projeto. A lista de e-mails abaixo ja barra esse caso de qualquer
// forma — os dois juntos e cinto e suspensorio.

service cloud.firestore {
  match /databases/{database}/documents {

    function doCasal() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
             'troque-pelo-email-do-felipe@exemplo.com',
             'troque-pelo-email-da-layla@exemplo.com'
           ];
    }

    // Plano/orcamento, milhas e demais documentos de configuracao.
    match /caderno/{doc} {
      allow read, write: if doCasal();
    }

    // Um documento por lancamento.
    match /lancamentos/{doc} {
      allow read, write: if doCasal();
    }

    // Nada alem disso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
